{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Kurisa-kuku/MINEWORLD-Datasets-site/blob/main/schemas/dataset.schema.json",
  "title": "MineWorld Dataset",
  "description": "Public metadata for one dataset listed in the MineWorld Datasets catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "summary",
    "license",
    "format",
    "compatibility",
    "environment",
    "scale",
    "tags",
    "access",
    "usage",
    "contributors",
    "history",
    "createdAt",
    "updatedAt"
  ],
  "definitions": {
    "localizedText": {
      "type": "object",
      "description": "Bilingual text. At least one language is required; missing translations fall back.",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "zh": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "minProperties": 1
    },
    "shortText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 360 },
        "zh": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "minProperties": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^(https://|mailto:)[^\\s]+$",
      "maxLength": 2048
    },
    "githubLogin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "kind"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "$ref": "#/definitions/url" },
        "kind": {
          "type": "string",
          "enum": ["download", "mirror", "request", "sample", "homepage", "paper", "benchmark"]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraftVersions", "verification", "streams"],
      "properties": {
        "minecraftVersions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9][0-9A-Za-z._ +()-]{0,31}$" },
          "uniqueItems": true,
          "maxItems": 12
        },
        "modVersions": {
          "type": "array",
          "items": { "type": "string", "maxLength": 32 },
          "uniqueItems": true,
          "maxItems": 12
        },
        "loader": { "type": ["string", "null"], "maxLength": 48 },
        "dataFormatVersion": { "type": ["string", "null"], "maxLength": 32 },
        "verification": {
          "type": "string",
          "enum": ["verified", "self-reported", "unverified", "not-applicable"]
        },
        "streams": {
          "type": "array",
          "items": { "type": "string", "enum": ["video", "state", "action", "events"] },
          "uniqueItems": true,
          "maxItems": 4
        }
      }
    }
  },
  "properties": {
    "slug": { "$ref": "#/definitions/slug" },
    "title": {
      "allOf": [
        { "$ref": "#/definitions/localizedText" },
        {
          "properties": {
            "en": { "maxLength": 100 },
            "zh": { "maxLength": 48 }
          }
        }
      ]
    },
    "summary": { "$ref": "#/definitions/shortText" },
    "license": {
      "type": "string",
      "enum": [
        "cc-by-4.0",
        "cc-by-sa-4.0",
        "cc0-1.0",
        "mit",
        "apache-2.0",
        "odc-by-1.0",
        "research-only",
        "all-rights-reserved",
        "other"
      ]
    },
    "cover": {
      "type": "string",
      "pattern": "^/covers/[a-z0-9-]+\\.webp$",
      "maxLength": 160
    },
    "coverThumb": {
      "type": "string",
      "pattern": "^/covers/[a-z0-9-]+-thumb\\.webp$",
      "maxLength": 170
    },
    "featured": { "type": "boolean" },
    "featuredRank": { "type": "integer", "minimum": 0, "maximum": 999 },
    "demo": {
      "type": "boolean",
      "description": "Seed/demo record. It must not link to a real download that is not actually available."
    },
    "format": {
      "type": "string",
      "enum": ["mwarecorder", "minecraft-replay", "raw-video", "custom-dataset", "other"]
    },
    "compatibility": { "$ref": "#/definitions/compatibility" },
    "environment": {
      "type": "string",
      "enum": ["singleplayer", "multiplayer", "mixed", "server", "custom-map"]
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodes", "bytes", "durationSeconds"],
      "properties": {
        "episodes": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "bytes": { "type": "integer", "minimum": 0 },
        "durationSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "dimensions", "trainingUses", "quality"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "building",
              "mining",
              "combat",
              "exploration",
              "farming",
              "crafting",
              "redstone",
              "navigation",
              "survival",
              "trading",
              "fishing",
              "parkour",
              "pvp",
              "speedrun"
            ]
          },
          "uniqueItems": true,
          "maxItems": 14
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["overworld", "nether", "end", "mixed", "superflat"]
          },
          "uniqueItems": true,
          "maxItems": 5
        },
        "trainingUses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "world-model",
              "imitation-learning",
              "offline-rl",
              "video-prediction",
              "agent-benchmark",
              "representation-learning",
              "navigation",
              "planning"
            ]
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "strict-verified",
              "alignment-checked",
              "community-reviewed",
              "clean-controls",
              "redacted",
              "needs-review",
              "experimental"
            ]
          },
          "uniqueItems": true,
          "maxItems": 7
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "links", "privacy"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["open", "request", "restricted"]
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/definitions/link" }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["personalData", "thirdPartyContent", "redistributionPermitted"],
          "properties": {
            "personalData": {
              "type": "boolean",
              "description": "true means the dataset contains real-player personal data."
            },
            "thirdPartyContent": {
              "type": "boolean",
              "description": "true means it includes third-party copyrighted content."
            },
            "redistributionPermitted": {
              "type": "boolean",
              "description": "true means the contributor has the right to redistribute it."
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["howToLoad", "recommendedUse", "limitations", "examples"],
      "properties": {
        "howToLoad": { "$ref": "#/definitions/localizedText" },
        "recommendedUse": { "$ref": "#/definitions/localizedText" },
        "limitations": { "$ref": "#/definitions/localizedText" },
        "examples": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/definitions/link" }
        }
      }
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["github", "roles"],
        "properties": {
          "github": { "$ref": "#/definitions/githubLogin" },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["uploader", "curator", "annotator", "maintainer"]
            },
            "uniqueItems": true
          },
          "note": { "type": "string", "maxLength": 160 }
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "type", "note"],
        "properties": {
          "date": { "$ref": "#/definitions/date" },
          "version": { "type": ["string", "null"], "maxLength": 32 },
          "type": {
            "type": "string",
            "enum": ["release", "metadata", "correction", "deprecation"]
          },
          "note": { "$ref": "#/definitions/localizedText" },
          "url": { "$ref": "#/definitions/url" }
        }
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["active", "deprecated", "superseded"] },
        "replacedBy": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "note": { "$ref": "#/definitions/localizedText" }
      }
    },
    "createdAt": { "$ref": "#/definitions/date" },
    "updatedAt": { "$ref": "#/definitions/date" },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "submittedBy": { "$ref": "#/definitions/githubLogin" },
        "source": { "type": "string", "enum": ["issue-form", "web-editor", "manual"] }
      }
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issueNumber": { "type": "integer", "minimum": 1 },
        "discussionUrl": { "$ref": "#/definitions/url" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "format": { "const": "mwarecorder" } },
        "required": ["format"]
      },
      "then": {
        "properties": {
          "compatibility": {
            "required": ["minecraftVersions", "modVersions", "dataFormatVersion", "streams"],
            "properties": {
              "minecraftVersions": { "minItems": 1 },
              "modVersions": { "minItems": 1 },
              "dataFormatVersion": { "type": "string", "minLength": 1 },
              "streams": { "minItems": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "format": { "const": "raw-video" } },
        "required": ["format"]
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "verification": { "enum": ["self-reported", "unverified", "not-applicable"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deprecation": {
            "properties": { "status": { "const": "superseded" } },
            "required": ["status"]
          }
        },
        "required": ["deprecation"]
      },
      "then": {
        "properties": {
          "deprecation": {
            "properties": { "replacedBy": { "type": "string", "minLength": 3 } },
            "required": ["replacedBy"]
          }
        }
      }
    }
  ]
}
