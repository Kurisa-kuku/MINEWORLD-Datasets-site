# -----------------------------------------------------------------------------
# Public site configuration
# Copy this file to `.env` for local builds and set the same values as GitHub
# Actions repository variables / secrets where relevant.
# -----------------------------------------------------------------------------

# The GitHub repository that stores this site AND the dataset JSON files.
# Change this one value if you fork the project.
PUBLIC_REPO_SLUG=Kurisa-kuku/MINEWORLD-Datasets-site

# The recorder this catalog is built around (button in the header).
PUBLIC_RECORDER_REPO=Kurisa-kuku/MineWorld-Agent-Recorder

# Optional: the production URL and base path. The deploy workflow sets these
# automatically for GitHub Pages project sites.
SITE_URL=https://kurisa-kuku.github.io
BASE_PATH=

# GitHub OAuth App client id for the browser device flow.
# GitHub's device endpoints do not send CORS headers, so pair this with the
# tiny optional device-flow proxy under workers/oauth-proxy and set its URL
# in PUBLIC_GITHUB_AUTH_BASE. Leave both blank to use the PAT fallback login
# (still a real GitHub login, useful before OAuth is configured).
PUBLIC_GITHUB_OAUTH_CLIENT_ID=
PUBLIC_GITHUB_AUTH_BASE=

# Extra comma-separated GitHub logins shown as moderators in the UI. Actual
# moderation power is always verified against the repository's push permission.
PUBLIC_ADMIN_LOGINS=Kurisa-kuku

# Giscus comments. Run https://giscus.app against the repo to obtain the ids.
# When empty the site shows a graceful GitHub Discussions fallback.
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
