---
import type { Lang } from '../config';
import { SITE, localePath } from '../config';
import { getT } from '../i18n';
import PixelIcon from './PixelIcon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = await getT(lang);
---
<div class="user-menu" data-auth-widget>
  <button
    type="button"
    class="btn btn--small user-login-btn js-auth-open"
    aria-haspopup="dialog"
    aria-controls="auth-dialog"
  >
    <PixelIcon name="github" size={14} />
    <span class="js-login-label">{t('actions.login')}</span>
  </button>

  <button
    type="button"
    class="user-trigger js-user-trigger"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={t('auth.dialogTitle')}
    hidden
  >
    <img class="avatar js-user-avatar" alt="" width="26" height="26" hidden />
    <span class="js-user-fallback" hidden aria-hidden="true">?</span>
    <span class="user-trigger__label js-user-name">…</span>
    <PixelIcon name="chevronDown" size={12} />
  </button>

  <div class="user-dropdown js-user-dropdown" role="menu" hidden>
    <div class="user-dropdown__head">
      <div class="user-dropdown__login js-user-login"></div>
      <div class="user-dropdown__role js-user-role"></div>
    </div>
    <a class="menu-item js-admin-link" href={localePath(lang, 'admin')} role="menuitem" hidden>
      <PixelIcon name="settings" size={14} /> {t('nav.admin')}
    </a>
    <a class="menu-item js-profile-link" href={SITE.github} target="_blank" rel="noopener noreferrer" role="menuitem">
      <PixelIcon name="github" size={14} /> {t('actions.viewGithub')}
    </a>
    <button type="button" class="menu-item js-logout" role="menuitem">
      <PixelIcon name="external" size={14} /> {t('auth.logout')}
    </button>
  </div>
</div>

<dialog id="auth-dialog" class="pixel-dialog" aria-labelledby="auth-dialog-title">
  <div class="dialog-head">
    <h2 class="dialog-title" id="auth-dialog-title">{t('auth.dialogTitle')}</h2>
    <button type="button" class="dialog-close js-dialog-close" aria-label={t('actions.close')}>
      <PixelIcon name="close" size={12} />
    </button>
  </div>
  <div class="dialog-body">
    <p class="js-auth-intro small muted">{t('auth.dialogIntro')}</p>

    <div class="notice notice--info" hidden={SITE.deviceFlowEnabled} style="margin-top:16px">
      <PixelIcon name="info" size={16} />
      <span>{t('auth.deviceNotConfigured')}</span>
    </div>

    <section hidden={!SITE.deviceFlowEnabled} style="margin-top:20px">
      <h3 class="h3" style="font-size:1rem">{t('auth.browserTitle')}</h3>
      <p class="small muted" style="margin-top:5px">{t('auth.browserDesc')}</p>
      <button type="button" class="btn btn--primary btn--block js-device-start" style="margin-top:12px">
        <PixelIcon name="github" size={14} />
        {t('auth.startBrowser')}
      </button>

      <div data-device-panel hidden style="margin-top:16px">
        <div class="panel panel--flat" style="padding:16px">
          <div class="eyebrow" style="margin-bottom:8px">{t('auth.deviceCodeTitle')}</div>
          <p class="small muted" style="margin-bottom:12px">{t('auth.deviceCodeDesc')}</p>
          <div class="cluster" style="justify-content:space-between">
            <span class="device-code js-device-code" aria-live="polite">— — —</span>
            <a class="btn btn--small js-device-link btn--gold" href="https://github.com/login/device" target="_blank" rel="noopener noreferrer">
              <PixelIcon name="external" size={12} /> {t('auth.openVerification')}
            </a>
          </div>
          <p class="status-line js-device-status" style="margin-top:12px;font-size:11px">{t('auth.waiting')}</p>
        </div>
      </div>
    </section>

    <div class="auth-divider">{t('auth.tokenTitle')}</div>

    <section hidden data-signed-in>
      <div class="user-chip">
        <div class="avatar" aria-hidden="true" style="display:grid;place-items:center;background:var(--grass);color:var(--grass-ink)">
          <PixelIcon name="github" size={15} />
        </div>
        <div>
          <div class="user-chip__name">{t('auth.welcome')}</div>
          <div class="small muted js-signed-in-text">@…</div>
        </div>
        <button type="button" class="btn btn--small btn--ghost js-dialog-logout" style="margin-left:auto">
          {t('auth.logout')}
        </button>
      </div>
    </section>

    <section style="margin-top:16px">
      <h3 class="h3" style="font-size:1rem">{t('auth.tokenTitle')}</h3>
      <p class="small muted" style="margin-top:5px">{t('auth.tokenDesc')}</p>
      <form class="js-token-form" style="margin-top:12px">
        <div class="field">
          <label for="github-token">{t('auth.tokenLabel')}</label>
          <input
            id="github-token"
            class="input js-token-input"
            type="password"
            name="token"
            autocomplete="off"
            spellcheck="false"
            placeholder={t('auth.tokenPlaceholder')}
            required
          />
          <p class="field-help">{t('auth.tokenPrivacy')}</p>
        </div>
        <button type="submit" class="btn btn--primary js-token-submit" style="margin-top:12px">
          <PixelIcon name="github" size={14} /> {t('auth.signInToken')}
        </button>
      </form>
      <div class="token-help" style="margin-top:10px">
        <a
          class="text-link"
          href="https://github.com/settings/tokens/new?scopes=public_repo,read:user&description=MineWorld%20Datasets"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('auth.patHelp')} <PixelIcon name="external" size={11} />
        </a>
      </div>
      <p class="js-auth-error status-line status-line--error" style="margin-top:12px" role="alert" hidden></p>
    </section>

    <p class="tiny faint" style="margin-top:22px;border-top:1px solid var(--line);padding-top:12px">
      {t('auth.securityNote')}
    </p>
  </div>
</dialog>

<script>
  import '../scripts/auth-widget';
</script>
