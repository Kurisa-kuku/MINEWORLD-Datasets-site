---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import type { Lang } from '../../config';
import { SITE, localePath } from '../../config';
import { getT } from '../../i18n';
import { getContributors, getLatestUpdateDate, getTagName } from '../../lib/data';
import { formatDate, formatInteger } from '../../lib/format';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const t = await getT(lang);
const contributors = getContributors(lang);
const latest = getLatestUpdateDate();
---
<BaseLayout lang={lang} title={t('contributors.title')} description={t('contributors.description')}>
  <header class="page-hero">
    <div class="container page-hero__inner">
      <div class="page-hero__copy">
        <div class="eyebrow">{t('contributors.eyebrow')}</div>
        <h1>{t('contributors.title')}</h1>
        <p class="page-hero__desc">{t('contributors.description')}</p>
        <p class="tiny faint" style="margin-top:12px">{t('contributors.lastUpdate')} · {formatDate(latest, lang)}</p>
      </div>
      <div class="library-count">
        {formatInteger(contributors.length, lang)}
        <span>{t('contributors.all')}</span>
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-head__copy">
          <div class="eyebrow">{t('contributors.eyebrow')}</div>
          <h2 class="h2">{t('contributors.totalContributors', { count: contributors.length })}</h2>
        </div>
      </div>

      <div class="contributor-grid">
        {contributors.map((contributor) => (
          <article class="contributor-card">
            <div class="contributor-card__top">
              <img
                class="contributor-card__avatar"
                src={`https://github.com/${contributor.github}.png?size=160`}
                alt=""
                width="56"
                height="56"
                loading="lazy"
                referrerpolicy="no-referrer"
              />
              <div style="min-width:0">
                <h3 class="contributor-card__name">@{contributor.github}</h3>
                <div class="contributor-card__meta">
                  {formatInteger(contributor.datasetCount, lang)} {t('contributors.datasets')}
                </div>
              </div>
            </div>
            <div class="contributor-card__roles">
              {contributor.roles.map((role) => (
                <span class={`badge ${role === 'maintainer' ? 'tone-amethyst' : role === 'uploader' ? 'tone-grass' : 'tone-sky'}`}>
                  {getTagName('contributorRoles', role, lang)}
                </span>
              ))}
            </div>
            <div class="contributor-card__datasets">
              <div class="contributor-card__datasets-label">{t('contributors.datasets')}</div>
              {contributor.datasets.map((dataset) => (
                <a class="contributor-card__dataset" href={localePath(lang, `datasets/${dataset.slug}`)}>
                  {dataset.title}
                </a>
              ))}
            </div>
            <div style="margin-top:12px">
              <a class="text-link" href={`https://github.com/${contributor.github}`} target="_blank" rel="noopener noreferrer">
                {t('contributors.openProfile')} <PixelIcon name="external" size={10} />
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="community-cta" style="margin-top:40px">
        <div>
          <div class="eyebrow">{t('contributors.thanks')}</div>
          <h2 style="font-size:clamp(1.2rem,2.2vw,1.6rem)">{t('contributors.become')}</h2>
          <p>{t('submit.description')}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={localePath(lang, 'submit')}>
            <PixelIcon name="upload" size={14} /> {t('home.ctaSubmit')}
          </a>
          <a class="btn" href={SITE.github} target="_blank" rel="noopener noreferrer">
            <PixelIcon name="github" size={14} /> GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
